    { "id": "math-02-f05", "subtopicId": "math-02-01", "front": { "en": "Place value vs digit value", "bm": "Nilai tempat vs nilai digit" }, "back": { "en": "Place value = bⁿ for the position. Digit value = digit × place value", "bm": "Nilai tempat = bⁿ bagi kedudukan. Nilai digit = digit × nilai tempat" } },
