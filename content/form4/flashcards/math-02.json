    { "id": "math-02-f13", "subtopicId": "math-02-01", "front": { "en": "Convert 1101₂ to base 10", "bm": "Tukar 1101₂ kepada asas 10" }, "back": { "en": "8 + 4 + 0 + 1 = 13", "bm": "8 + 4 + 0 + 1 = 13" } },
    { "id": "math-02-f14", "subtopicId": "math-02-01", "front": { "en": "Convert 23 to base 5", "bm": "Tukar 23 kepada asas 5" }, "back": { "en": "23 ÷ 5 = 4 r 3; 4 ÷ 5 = 0 r 4 → 43₅", "bm": "23 ÷ 5 = 4 baki 3; 4 ÷ 5 = 0 baki 4 → 43₅" }, "tip": { "en": "Check: 4 × 5 + 3 = 23.", "bm": "Semak: 4 × 5 + 3 = 23." } },
