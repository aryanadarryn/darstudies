    { "id": "math-02-f10", "subtopicId": "math-02-01", "front": { "en": "Base x → base y (neither is 10)", "bm": "Asas x → asas y (kedua-duanya bukan 10)" }, "back": { "en": "Go through base 10 first (unless it's the 2 ↔ 8 shortcut)", "bm": "Tukar kepada asas 10 dahulu (kecuali jalan pintas 2 ↔ 8)" } },
    { "id": "math-02-f11", "subtopicId": "math-02-01", "front": { "en": "In any base, b⁰ = ?", "bm": "Dalam sebarang asas, b⁰ = ?" }, "back": { "en": "1 — the last digit is always the 'ones' place", "bm": "1 — digit terakhir sentiasa di tempat 'sa'" } },
