    { "id": "math-02-f08", "subtopicId": "math-02-01", "front": { "en": "Base 8 ↔ base 2 shortcut", "bm": "Jalan pintas asas 8 ↔ asas 2" }, "back": { "en": "Each base 8 digit = a group of 3 base 2 digits (e.g. 6 = 110)", "bm": "Setiap digit asas 8 = kumpulan 3 digit asas 2 (cth. 6 = 110)" } },
