{
  "chapterId": "addmath-10",
  "cards": [
    { "id": "addmath-10-f01", "subtopicId": "addmath-10-01", "front": { "en": "Index number formula", "bm": "Rumus nombor indeks" }, "back": { "en": "I = Q₁/Q₀ × 100", "bm": "I = Q₁/Q₀ × 100" } },
    { "id": "addmath-10-f02", "subtopicId": "addmath-10-01", "front": { "en": "Q₀ and Q₁", "bm": "Q₀ dan Q₁" }, "back": { "en": "Q₀: quantity in the base year. Q₁: quantity in the given year", "bm": "Q₀: kuantiti pada tahun asas. Q₁: kuantiti pada tahun tertentu" } },
    { "id": "addmath-10-f03", "subtopicId": "addmath-10-01", "front": { "en": "Index > 100 / < 100", "bm": "Indeks > 100 / < 100" }, "back": { "en": "> 100: increase; < 100: decrease (e.g. 120 → +20%, 90 → −10%)", "bm": "> 100: kenaikan; < 100: penurunan (cth. 120 → +20%, 90 → −10%)" } },
    { "id": "addmath-10-f04", "subtopicId": "addmath-10-01", "front": { "en": "Chaining indices", "bm": "Merantaikan indeks" }, "back": { "en": "I₍c,a₎ = I₍b,a₎ × I₍c,b₎ / 100", "bm": "I₍c,a₎ = I₍b,a₎ × I₍c,b₎ / 100" } },
    { "id": "addmath-10-f05", "subtopicId": "addmath-10-01", "front": { "en": "Types of index numbers", "bm": "Jenis nombor indeks" }, "back": { "en": "Price index, quantity index, Consumer Price Index, stock market index (FBM KLCI)", "bm": "Indeks harga, indeks kuantiti, Indeks Harga Pengguna, indeks pasaran saham (FBM KLCI)" } },
    { "id": "addmath-10-f06", "subtopicId": "addmath-10-02", "front": { "en": "Composite index", "bm": "Indeks gubahan" }, "back": { "en": "Ī = ΣIw / Σw — a weighted average of indices", "bm": "Ī = ΣIw / Σw — purata berpemberat bagi indeks" } },
    { "id": "addmath-10-f07", "subtopicId": "addmath-10-02", "front": { "en": "Weightage", "bm": "Pemberat" }, "back": { "en": "Relative importance of an item; can be numbers, ratios, percentages or pie-chart angles", "bm": "Kepentingan relatif suatu item; boleh berupa nombor, nisbah, peratus atau sudut carta pai" } },
    { "id": "addmath-10-f08", "subtopicId": "addmath-10-02", "front": { "en": "Using a composite index to predict cost", "bm": "Menggunakan indeks gubahan untuk meramal kos" }, "back": { "en": "New cost = Ī/100 × old cost", "bm": "Kos baharu = Ī/100 × kos lama" } },
    { "id": "addmath-10-f09", "subtopicId": "addmath-10-02", "front": { "en": "Finding an unknown weight or index", "bm": "Mencari pemberat atau indeks yang tidak diketahui" }, "back": { "en": "Substitute into Ī = ΣIw / Σw and solve the linear equation", "bm": "Gantikan ke dalam Ī = ΣIw / Σw dan selesaikan persamaan linear" } },
    { "id": "addmath-10-f10", "subtopicId": "addmath-10-01", "front": { "en": "Base year", "bm": "Tahun asas" }, "back": { "en": "The reference year, given an index of 100", "bm": "Tahun rujukan, diberi indeks 100" } },
    { "id": "addmath-10-f11", "subtopicId": "addmath-10-01", "front": { "en": "Price RM20 (2020) → RM25 (2024). Index, 2020 = 100?", "bm": "Harga RM20 (2020) → RM25 (2024). Indeks, 2020 = 100?" }, "back": { "en": "25/20 × 100 = 125 — a 25% rise", "bm": "25/20 × 100 = 125 — kenaikan 25%" } },
    { "id": "addmath-10-f12", "subtopicId": "addmath-10-01", "front": { "en": "Index 80 and Q₀ = RM50. Find Q₁", "bm": "Indeks 80 dan Q₀ = RM50. Cari Q₁" }, "back": { "en": "Q₁ = 80/100 × 50 = RM40", "bm": "Q₁ = 80/100 × 50 = RM40" } },
    { "id": "addmath-10-f13", "subtopicId": "addmath-10-01", "front": { "en": "I(2022, base 2020) = 110, I(2024, base 2022) = 120. Find I(2024, base 2020)", "bm": "I(2022, asas 2020) = 110, I(2024, asas 2022) = 120. Cari I(2024, asas 2020)" }, "back": { "en": "110 × 120 ÷ 100 = 132", "bm": "110 × 120 ÷ 100 = 132" } },
    { "id": "addmath-10-f14", "subtopicId": "addmath-10-02", "front": { "en": "Indices 120 and 110 with weights 3 and 2", "bm": "Indeks 120 dan 110 dengan pemberat 3 dan 2" }, "back": { "en": "Ī = (120 × 3 + 110 × 2) ÷ 5 = 580 ÷ 5 = 116", "bm": "Ī = (120 × 3 + 110 × 2) ÷ 5 = 580 ÷ 5 = 116" } },
    { "id": "addmath-10-f15", "subtopicId": "addmath-10-02", "front": { "en": "Composite index 116; cost in the base year RM500", "bm": "Indeks gubahan 116; kos pada tahun asas RM500" }, "back": { "en": "New cost = 116/100 × 500 = RM580", "bm": "Kos baharu = 116/100 × 500 = RM580" } }
  ]
