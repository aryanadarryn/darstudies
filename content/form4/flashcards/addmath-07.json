    { "id": "addmath-07-f11", "subtopicId": "addmath-07-04", "front": { "en": "Locus with PA : PB = m : n", "bm": "Lokus dengan PA : PB = m : n" }, "back": { "en": "Set n·PA = m·PB, square both sides and simplify", "bm": "Tetapkan n·PA = m·PB, kuasaduakan kedua-dua belah dan permudahkan" } },
    { "id": "addmath-07-f12", "subtopicId": "addmath-07-01", "front": { "en": "Distance between (1, 2) and (4, 6)", "bm": "Jarak antara (1, 2) dan (4, 6)" }, "back": { "en": "√(3² + 4²) = √25 = 5", "bm": "√(3² + 4²) = √25 = 5" } },
