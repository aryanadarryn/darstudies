    "keyTerms": [
      {
        "term": {
          "en": "Awalan",
          "bm": "Awalan"
        },
        "definition": {
          "en": "Prefix added before the root: meN-, beR-, peN-, di-, ter-, ke-, se-.",
          "bm": "Imbuhan di hadapan kata dasar: meN-, beR-, peN-, di-, ter-, ke-, se-."
        }
      },
      {
        "term": {
          "en": "Akhiran",
          "bm": "Akhiran"
        },
        "definition": {
          "en": "Suffix added after the root: -kan, -i, -an.",
          "bm": "Imbuhan di belakang kata dasar: -kan, -i, -an."
        }
      },
      {
        "term": {
          "en": "Apitan",
          "bm": "Apitan"
        },
        "definition": {
          "en": "Circumfix around the root: ke-…-an, peN-…-an, meN-…-kan.",
          "bm": "Imbuhan yang mengapit kata dasar: ke-…-an, peN-…-an, meN-…-kan."
        }
      },
      {
        "term": {
          "en": "Sisipan",
          "bm": "Sisipan"
        },
        "definition": {
          "en": "Infix inside the root: -el- (telunjuk), -em- (gemuruh), -er- (gerigi).",
          "bm": "Imbuhan di dalam kata dasar: -el- (telunjuk), -em- (gemuruh), -er- (gerigi)."
        }
      },
      {
        "term": {
          "en": "Kata majmuk",
          "bm": "Kata majmuk"
        },
        "definition": {
          "en": "Two words forming one meaning: kapal terbang, kaki bangku.",
          "bm": "Dua kata yang membentuk satu makna: kapal terbang, kaki bangku."
        }
      },
      {
        "term": {
          "en": "Kata ganda berentak",
          "bm": "Kata ganda berentak"
        },
        "definition": {
          "en": "Rhythmic reduplication: sayur-mayur, gunung-ganang.",
          "bm": "Penggandaan berirama: sayur-mayur, gunung-ganang."
        }
      }
    ],
