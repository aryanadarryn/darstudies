    "hook": {
      "en": "In fieldwork you leave the classroom and become a real geographer: you measure, interview and map your own area.",
      "bm": "Dalam kerja lapangan, anda keluar dari kelas dan menjadi ahli geografi sebenar: mengukur, menemu bual dan memetakan kawasan sendiri."
    },
    "bigIdeas": [
      {
        "en": "Fieldwork begins with a clear issue and objectives.",
        "bm": "Kerja lapangan bermula dengan isu dan objektif yang jelas."
      },
      {
        "en": "Data comes from observation, interviews, questionnaires and measurement.",
        "bm": "Data diperoleh melalui pemerhatian, temu bual, soal selidik dan pengukuran."
      },
      {
        "en": "Results are analysed and reported.",
        "bm": "Dapatan dianalisis dan dilaporkan."
