  "intro": {
    "hook": {
      "en": "A map fits a whole country onto one page. Scale tells you exactly how much it has been shrunk.",
      "bm": "Peta memuatkan seluruh negara pada satu halaman. Skala menunjukkan sebanyak mana ia dikecilkan."
    },
    "bigIdeas": [
      {
        "en": "Scale is the ratio of map distance to actual distance.",
        "bm": "Skala ialah nisbah jarak peta kepada jarak sebenar."
      },
      {
        "en": "Scale can be a statement, a linear scale or a ratio.",
        "bm": "Skala boleh berbentuk pernyataan, skala lurus atau nisbah."
      },
      {
        "en": "Actual distance = map distance × scale.",
        "bm": "Jarak sebenar = jarak peta × skala."
      }
    ],
