  "subtopics": {
    "f2rbt-01-01": {
      "keyPoints": [
        {
          "en": "Ask what is really going wrong.",
          "bm": "Tanya apa sebenarnya yang salah."
        },
        {
          "en": "Look for contradictions.",
          "bm": "Cari percanggahan."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Root cause",
            "bm": "Punca akar"
          },
          "meaning": {
            "en": "The deepest cause.",
            "bm": "Punca paling dalam."
          }
        }
      ],
      "example": {
        "question": {
          "en": "Inventive or not: heavy bag is hard to carry?",
          "bm": "Inventif atau tidak: beg berat sukar dibawa?"
        },
        "answer": {
          "en": "Often solved by known wheels: not inventive.",
          "bm": "Biasa diselesaikan dengan roda: tidak inventif."
        }
      },
      "tip": {
        "en": "Use \"why?\" five times to find the cause.",
        "bm": "Tanya \"mengapa?\" lima kali untuk mencari punca."
      }
    },
    "f2rbt-01-02": {
      "keyPoints": [
        {
          "en": "Name the components.",
          "bm": "Namakan komponen."
        },
        {
          "en": "Show useful and harmful actions.",
          "bm": "Tunjukkan tindakan berguna dan memudaratkan."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Component",
            "bm": "Komponen"
          },
          "meaning": {
            "en": "A part of a system.",
            "bm": "Bahagian sistem."
          }
        }
      ],
      "example": {
        "question": {
          "en": "Action of a kettle on water?",
          "bm": "Tindakan cerek pada air?"
        },
        "answer": {
          "en": "Heats it",
          "bm": "Memanaskannya"
        }
      },
      "tip": {
        "en": "Draw arrows from tool to object.",
        "bm": "Lukis anak panah dari alat ke objek."
      }
    },
    "f2rbt-01-03": {
      "keyPoints": [
        {
          "en": "State the contradiction clearly.",
          "bm": "Nyatakan percanggahan dengan jelas."
        },
        {
          "en": "Separate in time, space or condition.",
          "bm": "Pisahkan mengikut masa, ruang atau keadaan."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Separation",
            "bm": "Pemisahan"
          },
          "meaning": {
