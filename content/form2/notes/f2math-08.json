    "f2math-08-01": {
      "keyPoints": [
        {
          "en": "A function can be shown as an equation, table, arrow diagram or graph.",
          "bm": "Fungsi boleh ditunjukkan sebagai persamaan, jadual, gambar rajah anak panah atau graf."
        },
        {
          "en": "Many-to-one is a function; one-to-many is not.",
          "bm": "Banyak kepada satu ialah fungsi; satu kepada banyak bukan fungsi."
        },
        {
          "en": "f(x) is the output for input x.",
          "bm": "f(x) ialah output bagi input x."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Input",
            "bm": "Input"
          },
          "meaning": {
            "en": "Value put in.",
            "bm": "Nilai dimasukkan."
          }
        },
        {
          "term": {
            "en": "Output",
            "bm": "Output"
          },
          "meaning": {
            "en": "Value that comes out.",
            "bm": "Nilai dihasilkan."
          }
        }
      ],
      "example": {
        "question": {
          "en": "f(x) = x + 5. f(2)?",
          "bm": "f(x) = x + 5. f(2)?"
        },
        "answer": {
          "en": "7",
          "bm": "7"
        }
      },
      "tip": {
        "en": "Put negative inputs in brackets.",
        "bm": "Letak input negatif dalam kurungan."
      }
    },
    "f2math-08-02": {
      "keyPoints": [
        {
          "en": "Make a table of x and y values.",
          "bm": "Bina jadual nilai x dan y."
        },
        {
          "en": "Plot points and join with a line or smooth curve.",
          "bm": "Plot titik dan sambung dengan garis atau lengkung licin."
        },
        {
          "en": "Read values from the graph with guide lines.",
          "bm": "Baca nilai daripada graf dengan garis panduan."
        }
      ],
      "keywords": [
