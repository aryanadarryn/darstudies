    "f2math-06-03": {
      "keyPoints": [
        {
          "en": "Surface area = total area of all faces.",
          "bm": "Luas permukaan = jumlah luas semua permukaan."
        },
        {
          "en": "Open or closed changes the total.",
          "bm": "Terbuka atau tertutup mengubah jumlahnya."
        },
        {
          "en": "Curved cylinder area = 2πrh.",
          "bm": "Luas melengkung silinder = 2πjt."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Slant height",
            "bm": "Tinggi condong"
          },
          "meaning": {
            "en": "Length along a cone's side.",
            "bm": "Panjang di sepanjang sisi kon."
          }
        }
      ],
      "example": {
        "question": {
          "en": "Cube side 4 cm. SA?",
          "bm": "Kubus sisi 4 cm. Luas permukaan?"
        },
        "answer": {
          "en": "96 cm²",
          "bm": "96 cm²"
        }
      },
      "tip": {
        "en": "Sketch the net so that no face is missed.",
        "bm": "Lakar bentangan supaya tiada permukaan tertinggal."
      }
    },
    "f2math-06-04": {
      "keyPoints": [
        {
          "en": "Prism/cylinder: base area × height.",
          "bm": "Prisma/silinder: luas tapak × tinggi."
        },
        {
          "en": "Pyramid/cone: ⅓ × base area × height.",
          "bm": "Piramid/kon: ⅓ × luas tapak × tinggi."
        },
        {
          "en": "Sphere: (4/3)πr³.",
          "bm": "Sfera: (4/3)πj³."
        }
      ],
