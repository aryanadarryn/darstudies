          },
          "meaning": {
            "en": "Speed at the start.",
            "bm": "Laju pada permulaan."
          }
        },
        {
          "term": {
            "en": "Final speed",
            "bm": "Laju akhir"
          },
          "meaning": {
            "en": "Speed at the end.",
            "bm": "Laju pada akhirnya."
          }
        }
      ],
