    "f2math-09-01": {
      "keyPoints": [
        {
          "en": "Speed = distance ÷ time.",
          "bm": "Laju = jarak ÷ masa."
        },
        {
          "en": "Use total distance ÷ total time for average speed.",
          "bm": "Guna jumlah jarak ÷ jumlah masa untuk laju purata."
        },
        {
          "en": "Do not average the speeds themselves.",
          "bm": "Jangan purata laju-laju itu sendiri."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Uniform speed",
            "bm": "Laju seragam"
          },
          "meaning": {
            "en": "Constant rate.",
            "bm": "Kadar tetap."
          }
        },
        {
          "term": {
            "en": "Average speed",
            "bm": "Laju purata"
          },
          "meaning": {
            "en": "Whole trip rate.",
            "bm": "Kadar seluruh perjalanan."
          }
        }
      ],
      "example": {
        "question": {
          "en": "45 min for 60 km. Speed?",
          "bm": "45 min untuk 60 km. Laju?"
        },
        "answer": {
          "en": "80 km/h",
          "bm": "80 km/j"
        }
      },
      "tip": {
        "en": "Convert minutes to hours first: 45 min = 0.75 h.",
        "bm": "Tukar minit kepada jam dahulu: 45 min = 0.75 j."
      }
    },
    "f2math-09-02": {
      "keyPoints": [
        {
          "en": "a = (v − u) ÷ t.",
          "bm": "a = (v − u) ÷ t."
        },
        {
          "en": "Positive when speeding up.",
          "bm": "Positif apabila laju bertambah."
        },
        {
          "en": "Negative when slowing down.",
          "bm": "Negatif apabila laju berkurang."
        }
      ],
      "keywords": [
