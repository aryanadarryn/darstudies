  "subtopics": {
    "f2geo-11-01": {
      "keyPoints": [
        {
          "en": "Pick a real issue in your area.",
          "bm": "Pilih isu sebenar di kawasan anda."
        },
        {
          "en": "Keep the title clear and specific.",
          "bm": "Pastikan tajuk jelas dan khusus."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Issue",
            "bm": "Isu"
          },
          "meaning": {
            "en": "A matter worth studying.",
            "bm": "Perkara yang wajar dikaji."
          }
        }
      ],
      "example": {
        "question": {
          "en": "Good title on floods?",
          "bm": "Tajuk baik tentang banjir?"
        },
        "answer": {
          "en": "Flash floods at Kampung Baru",
          "bm": "Banjir kilat di Kampung Baru"
        }
      },
      "tip": {
        "en": "Choose a place you can actually visit.",
        "bm": "Pilih tempat yang boleh dilawati."
      }
    },
    "f2geo-11-02": {
      "keyPoints": [
        {
          "en": "Objectives guide the study.",
          "bm": "Objektif memandu kajian."
        },
        {
          "en": "Choose methods that answer the objectives.",
          "bm": "Pilih kaedah yang menjawab objektif."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Respondent",
            "bm": "Responden"
          },
          "meaning": {
            "en": "A person who answers questions.",
            "bm": "Orang yang menjawab soalan."
          }
        }
      ],
      "example": {
        "question": {
          "en": "One method for traffic counting?",
          "bm": "Satu kaedah mengira trafik?"
        },
        "answer": {
          "en": "Observation",
          "bm": "Pemerhatian"
        }
      },
      "tip": {
        "en": "Write 2–3 objectives only.",
        "bm": "Tulis 2–3 objektif sahaja."
      }
    },
    "f2geo-11-03": {
      "keyPoints": [
        {
          "en": "Record carefully in tables.",
          "bm": "Rekod dengan teliti dalam jadual."
        },
        {
          "en": "Turn data into graphs and find patterns.",
          "bm": "Tukar data kepada graf dan cari pola."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Analysis",
            "bm": "Analisis"
          },
          "meaning": {
            "en": "Explaining what data means.",
            "bm": "Menerangkan maksud data."
          }
        }
      ],
      "example": {
        "question": {
          "en": "15 of 60 said yes. Percent?",
          "bm": "15 daripada 60 kata ya. Peratus?"
        },
        "answer": {
          "en": "25%",
          "bm": "25%"
        }
      },
      "tip": {
        "en": "Label every graph and give it a title.",
        "bm": "Labelkan setiap graf dan beri tajuk."
      }
    },
    "f2geo-11-04": {
      "keyPoints": [
        {
          "en": "State findings and suggestions.",
          "bm": "Nyatakan dapatan dan cadangan."
        },
        {
          "en": "List sources in references.",
          "bm": "Senaraikan sumber dalam rujukan."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Conclusion",
            "bm": "Rumusan"
          },
          "meaning": {
            "en": "Summary of what was found.",
            "bm": "Ringkasan dapatan."
          }
        }
      ],
      "example": {
        "question": {
          "en": "What goes in the conclusion?",
          "bm": "Apa dalam rumusan?"
        },
        "answer": {
          "en": "Main findings and suggestions.",
          "bm": "Dapatan utama dan cadangan."
        }
      },
      "tip": {
        "en": "Answer your objectives in the conclusion.",
        "bm": "Jawab objektif anda dalam rumusan."
      }
    }
  }
