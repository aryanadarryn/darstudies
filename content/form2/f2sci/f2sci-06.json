    },
    "bigIdeas": [
      {
        "en": "Acids have pH below 7 and alkalis above 7.",
        "bm": "Asid mempunyai pH bawah 7 dan alkali atas 7."
      },
      {
        "en": "Indicators show whether a substance is acidic or alkaline.",
        "bm": "Penunjuk menunjukkan sama ada bahan berasid atau beralkali."
      },
      {
        "en": "Acid + alkali → salt + water.",
        "bm": "Asid + alkali → garam + air."
      }
