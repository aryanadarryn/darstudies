    "workedExample": {
      "question": {
        "en": "An echo returns in 2 s in water (1500 m/s). How deep is the seabed?",
        "bm": "Gema kembali dalam 2 s di dalam air (1500 m/s). Berapa dalam dasar laut?"
      },
      "steps": [
        {
          "en": "Total distance = 1500 × 2 = 3000 m.",
          "bm": "Jumlah jarak = 1500 × 2 = 3000 m."
        },
        {
          "en": "Depth is half of it.",
          "bm": "Kedalaman ialah separuhnya."
        }
      ],
      "answer": {
        "en": "1500 m",
        "bm": "1500 m"
      }
    }
