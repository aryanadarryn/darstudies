  "intro": {
    "hook": {
      "en": "Ships measure the depth of the sea by timing an echo, and bats hunt in the dark in the same way.",
      "bm": "Kapal mengukur kedalaman laut dengan masa gema, dan kelawar memburu dalam gelap dengan cara yang sama."
    },
    "bigIdeas": [
      {
        "en": "Sound is a longitudinal wave made by vibrations.",
        "bm": "Bunyi ialah gelombang membujur yang terhasil daripada getaran."
      },
      {
        "en": "Amplitude controls loudness; frequency controls pitch.",
        "bm": "Amplitud mengawal kenyaringan; frekuensi mengawal kelangsingan."
      },
      {
        "en": "Reflected sound gives echoes, used in sonar.",
        "bm": "Bunyi terpantul memberi gema, digunakan dalam sonar."
      }
    ],
