  "intro": {
    "hook": {
      "en": "Why are manhole covers round? A circle has the same width in every direction, so the cover cannot fall through the hole.",
      "bm": "Mengapa penutup lurang bulat? Bulatan mempunyai lebar yang sama pada setiap arah, jadi penutup tidak boleh jatuh ke dalam lubang."
    },
    "bigIdeas": [
      {
        "en": "All points on a circle are the same distance from its centre.",
        "bm": "Semua titik pada bulatan sama jarak dari pusatnya."
      },
      {
        "en": "A perpendicular from the centre bisects a chord.",
        "bm": "Garis serenjang dari pusat membahagi dua sama perentas."
      },
      {
        "en": "C = 2πr and A = πr².",
        "bm": "L = 2πj dan A = πj²."
      }
    ],
