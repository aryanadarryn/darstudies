    "workedExample": {
      "question": {
        "en": "Find the area of a sector with radius 7 cm and angle 90° (π = 22/7).",
        "bm": "Cari luas sektor berjejari 7 cm dan bersudut 90° (π = 22/7)."
      },
      "steps": [
        {
          "en": "Fraction of circle = 90/360 = ¼.",
          "bm": "Pecahan bulatan = 90/360 = ¼."
        },
        {
          "en": "¼ × 22/7 × 7 × 7",
          "bm": "¼ × 22/7 × 7 × 7"
        }
      ],
      "answer": {
        "en": "38.5 cm²",
        "bm": "38.5 cm²"
      }
    }
