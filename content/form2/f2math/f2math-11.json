  "intro": {
    "hook": {
      "en": "Slide a tile, flip it or spin it. It is still the same size and shape. Those moves are isometries, and they make up every wallpaper and batik pattern.",
      "bm": "Gelongsorkan tile, terbalikkannya atau pusingkannya. Saiz dan bentuknya tetap sama. Pergerakan itu ialah isometri, dan ia membentuk setiap corak kertas dinding dan batik."
    },
    "bigIdeas": [
      {
        "en": "A transformation moves an object to a new image.",
        "bm": "Transformasi menggerakkan objek ke imej baharu."
      },
      {
        "en": "Isometries keep shape and size.",
        "bm": "Isometri mengekalkan bentuk dan saiz."
      },
      {
        "en": "Order of rotational symmetry counts matching positions per turn.",
        "bm": "Peringkat simetri putaran mengira kedudukan sepadan dalam satu pusingan."
      }
    ],
