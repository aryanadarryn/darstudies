  "intro": {
    "hook": {
      "en": "A weather forecast of 70% rain is probability at work: it turns uncertainty into a number you can plan with.",
      "bm": "Ramalan cuaca 70% hujan ialah kebarangkalian: ia menukar ketidakpastian kepada nombor yang boleh dirancang."
    },
    "bigIdeas": [
      {
        "en": "Probability is a number from 0 to 1.",
        "bm": "Kebarangkalian ialah nombor dari 0 hingga 1."
      },
      {
        "en": "Experiments estimate it; theory calculates it.",
        "bm": "Eksperimen menganggarkannya; teori mengiranya."
      },
      {
        "en": "P(A′) = 1 − P(A).",
        "bm": "P(A′) = 1 − P(A)."
      }
    ],
    "infographic": {
