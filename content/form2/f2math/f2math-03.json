    "workedExample": {
      "question": {
        "en": "Make x the subject of y = 3x − 5.",
        "bm": "Jadikan x perkara rumus bagi y = 3x − 5."
      },
      "steps": [
        {
          "en": "Add 5: y + 5 = 3x.",
          "bm": "Tambah 5: y + 5 = 3x."
        },
        {
          "en": "Divide by 3.",
          "bm": "Bahagi dengan 3."
        }
      ],
      "answer": {
        "en": "x = (y + 5)/3",
        "bm": "x = (y + 5)/3"
      }
    }
