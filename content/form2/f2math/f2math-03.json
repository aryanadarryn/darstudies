  "intro": {
    "hook": {
      "en": "A formula is a recipe: put in the known numbers and the answer comes out. Rearrange it and the same recipe answers a different question.",
      "bm": "Rumus ialah resipi: masukkan nombor yang diketahui dan jawapan akan terhasil. Susun semula, dan resipi yang sama menjawab soalan lain."
    },
    "bigIdeas": [
      {
        "en": "A formula is an equation connecting variables.",
        "bm": "Rumus ialah persamaan yang menghubungkan pemboleh ubah."
      },
      {
        "en": "The subject is the variable on its own.",
        "bm": "Perkara rumus ialah pemboleh ubah yang berdiri sendiri."
      },
      {
        "en": "Do the same operation to both sides when rearranging.",
        "bm": "Lakukan operasi yang sama pada kedua-dua belah semasa menyusun semula."
      }
    ],
    "infographic": {
      "kind": "process",
      "data": {
        "steps": [
          {
            "title": {
              "en": "Write the formula",
              "bm": "Tulis rumus"
            },
            "detail": {
              "en": "A = l × w",
              "bm": "A = l × w"
            }
          },
          {
            "title": {
              "en": "Choose the new subject",
              "bm": "Pilih perkara rumus baharu"
            },
            "detail": {
              "en": "w",
              "bm": "w"
            }
          },
          {
            "title": {
              "en": "Undo operations",
              "bm": "Songsangkan operasi"
            },
            "detail": {
              "en": "Divide both sides by l",
              "bm": "Bahagi kedua-dua belah dengan l"
            }
          },
          {
            "title": {
              "en": "Write the result",
              "bm": "Tulis hasil"
            },
            "detail": {
              "en": "w = A ÷ l",
              "bm": "w = A ÷ l"
            }
          }
        ]
      }
    },
    "keyTerms": [
