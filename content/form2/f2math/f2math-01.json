    "workedExample": {
      "question": {
        "en": "Find the 20th term of 5, 8, 11, 14, …",
        "bm": "Cari sebutan ke-20 bagi 5, 8, 11, 14, …"
      },
      "steps": [
        {
          "en": "The rule is add 3, so the expression begins with 3n.",
          "bm": "Peraturannya tambah 3, jadi ungkapan bermula dengan 3n."
        },
        {
          "en": "When n = 1, 3n = 3 but the term is 5, so Tₙ = 3n + 2.",
          "bm": "Apabila n = 1, 3n = 3 tetapi sebutannya 5, maka Tₙ = 3n + 2."
        },
        {
          "en": "T₂₀ = 3(20) + 2",
          "bm": "T₂₀ = 3(20) + 2"
        }
      ],
      "answer": {
        "en": "62",
        "bm": "62"
      }
    }
  },
