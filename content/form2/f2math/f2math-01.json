  "intro": {
    "hook": {
      "en": "Sunflower seeds, rabbit families and even your phone's lock patterns hide number rules. Spot the rule and you can predict any term without listing them all.",
      "bm": "Biji bunga matahari, keluarga arnab dan corak kunci telefon menyembunyikan peraturan nombor. Kenal pasti peraturannya, dan anda boleh meramal mana-mana sebutan tanpa menyenaraikan semuanya."
    },
    "bigIdeas": [
      {
        "en": "A pattern is a rule that links numbers or objects.",
        "bm": "Pola ialah peraturan yang menghubungkan nombor atau objek."
      },
      {
        "en": "A sequence is a set of numbers arranged by a pattern.",
        "bm": "Jujukan ialah set nombor yang disusun mengikut pola."
      },
      {
        "en": "An algebraic expression gives the nth term directly.",
        "bm": "Ungkapan algebra memberi sebutan ke-n secara terus."
      }
    ],
