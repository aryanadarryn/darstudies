  "intro": {
    "hook": {
      "en": "A car's speedometer shows speed at this very moment. Your average speed for the whole journey is usually a different number.",
      "bm": "Meter laju kereta menunjukkan laju pada saat itu. Laju purata untuk seluruh perjalanan biasanya berbeza."
    },
    "bigIdeas": [
      {
        "en": "Speed = distance ÷ time.",
        "bm": "Laju = jarak ÷ masa."
      },
      {
        "en": "Average speed = total distance ÷ total time.",
        "bm": "Laju purata = jumlah jarak ÷ jumlah masa."
      },
      {
        "en": "Acceleration is the rate of change of speed.",
        "bm": "Pecutan ialah kadar perubahan laju."
      }
    ],
