          "bm": "Pasangan tertib (x, y) yang memberi kedudukan."
        }
      },
      {
        "term": {
          "en": "Midpoint",
          "bm": "Titik tengah"
        },
        "definition": {
          "en": "The point halfway between two points.",
          "bm": "Titik di tengah-tengah dua titik."
        }
      },
      {
        "term": {
          "en": "Origin",
          "bm": "Asalan"
