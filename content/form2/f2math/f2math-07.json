    ],
    "workedExample": {
      "question": {
        "en": "Find the distance between A(−2, −1) and B(4, 3)… then its midpoint.",
        "bm": "Cari jarak antara A(−2, −1) dan B(4, 3)… kemudian titik tengahnya."
      },
      "steps": [
        {
          "en": "Changes: 6 and 4.",
          "bm": "Perubahan: 6 dan 4."
        },
        {
          "en": "√(36 + 16) = √52 ≈ 7.21.",
          "bm": "√(36 + 16) = √52 ≈ 7.21."
        },
        {
          "en": "Midpoint = ((−2 + 4)/2, (−1 + 3)/2).",
          "bm": "Titik tengah = ((−2 + 4)/2, (−1 + 3)/2)."
        }
      ],
      "answer": {
        "en": "7.21 units; (1, 1)",
        "bm": "7.21 unit; (1, 1)"
      }
    }
  },
