  "intro": {
    "hook": {
      "en": "Your phone's map finds the distance between two places from their coordinates. The same idea works on a Cartesian plane with Pythagoras' theorem.",
      "bm": "Peta telefon mencari jarak antara dua tempat daripada koordinatnya. Idea yang sama digunakan pada satah Cartes dengan teorem Pythagoras."
    },
    "bigIdeas": [
      {
        "en": "Distance comes from Pythagoras' theorem.",
        "bm": "Jarak berasal daripada teorem Pythagoras."
      },
      {
        "en": "A midpoint averages the x and y coordinates.",
        "bm": "Titik tengah ialah purata koordinat x dan y."
      },
      {
        "en": "Coordinates help solve shape and map problems.",
        "bm": "Koordinat membantu menyelesaikan masalah bentuk dan peta."
      }
    ],
    "infographic": {
      "kind": "process",
      "data": {
        "steps": [
          {
            "title": {
              "en": "Find horizontal change",
              "bm": "Cari perubahan mengufuk"
            },
            "detail": {
              "en": "x₂ − x₁",
              "bm": "x₂ − x₁"
            }
          },
          {
            "title": {
              "en": "Find vertical change",
              "bm": "Cari perubahan mencancang"
            },
            "detail": {
              "en": "y₂ − y₁",
              "bm": "y₂ − y₁"
            }
          },
          {
            "title": {
              "en": "Square and add",
              "bm": "Kuasa dua dan tambah"
            },
            "detail": {
              "en": "Pythagoras",
              "bm": "Pythagoras"
            }
          },
          {
            "title": {
              "en": "Take the square root",
              "bm": "Ambil punca kuasa dua"
            },
            "detail": {
              "en": "That is the distance",
              "bm": "Itulah jarak"
            }
          }
        ]
      }
    },
    "keyTerms": [
      {
        "term": {
          "en": "Coordinates",
          "bm": "Koordinat"
        },
        "definition": {
