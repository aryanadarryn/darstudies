    "hook": {
      "en": "Honeycomb cells are hexagons because six angles of 120° fit perfectly round a point with no gaps. Polygon angles explain why.",
      "bm": "Sel sarang lebah berbentuk heksagon kerana enam sudut 120° muat sempurna di sekeliling titik tanpa ruang. Sudut poligon menjelaskan sebabnya."
    },
    "bigIdeas": [
      {
        "en": "A regular polygon has equal sides and equal angles.",
        "bm": "Poligon sekata mempunyai sisi sama panjang dan sudut sama besar."
      },
      {
        "en": "Sum of interior angles = (n − 2) × 180°.",
        "bm": "Hasil tambah sudut pedalaman = (n − 2) × 180°."
      },
      {
        "en": "Exterior angles of any polygon add to 360°.",
        "bm": "Sudut peluaran mana-mana poligon berjumlah 360°."
      }
    ],
