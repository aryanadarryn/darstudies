    "workedExample": {
      "question": {
        "en": "For y = x² − 3, find y when x = −2 and x = 2.",
        "bm": "Bagi y = x² − 3, cari y apabila x = −2 dan x = 2."
      },
      "steps": [
        {
          "en": "(−2)² − 3 = 1",
          "bm": "(−2)² − 3 = 1"
        },
        {
          "en": "2² − 3 = 1",
          "bm": "2² − 3 = 1"
        }
      ],
      "answer": {
        "en": "y = 1 for both",
        "bm": "y = 1 bagi kedua-duanya"
      }
    }
