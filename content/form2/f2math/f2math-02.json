    "workedExample": {
      "question": {
        "en": "Factorise x² + 7x + 12.",
        "bm": "Faktorkan x² + 7x + 12."
      },
      "steps": [
        {
          "en": "Find two numbers that multiply to 12 and add to 7.",
          "bm": "Cari dua nombor yang hasil darabnya 12 dan hasil tambahnya 7."
        },
        {
          "en": "3 and 4 work.",
          "bm": "3 dan 4 sesuai."
        }
      ],
      "answer": {
        "en": "(x + 3)(x + 4)",
        "bm": "(x + 3)(x + 4)"
      }
    }
  },
