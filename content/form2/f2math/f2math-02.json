{
  "chapterId": "f2math-02",
  "reviewed": false,
  "intro": {
    "hook": {
      "en": "Expansion opens the brackets and factorisation closes them again, much like unpacking and repacking a bag so that everything fits.",
      "bm": "Kembangan membuka kurungan dan pemfaktoran menutupnya semula, seperti membongkar dan mengemas beg supaya semuanya muat."
    },
    "bigIdeas": [
      {
        "en": "Expanding multiplies every term in one bracket by every term in the other.",
        "bm": "Kembangan mendarab setiap sebutan dalam satu kurungan dengan setiap sebutan dalam kurungan lain."
      },
      {
        "en": "Factorisation is the reverse of expansion.",
        "bm": "Pemfaktoran ialah songsangan kembangan."
      },
      {
        "en": "Algebraic fractions follow the same rules as number fractions.",
        "bm": "Pecahan algebra mengikut peraturan yang sama seperti pecahan nombor."
      }
    ],
