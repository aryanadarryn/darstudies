  "intro": {
    "hook": {
      "en": "Road signs warn of a 10% slope: the road rises 10 m for every 100 m across. That ratio is gradient.",
      "bm": "Papan tanda memberi amaran cerun 10%: jalan naik 10 m bagi setiap 100 m mengufuk. Nisbah itulah kecerunan."
    },
    "bigIdeas": [
      {
        "en": "Gradient = vertical distance ÷ horizontal distance.",
        "bm": "Kecerunan = jarak mencancang ÷ jarak mengufuk."
      },
      {
        "en": "Sign shows direction; size shows steepness.",
        "bm": "Tanda menunjukkan arah; magnitud menunjukkan kecuraman."
      },
      {
        "en": "Gradients can be found from two points or intercepts.",
        "bm": "Kecerunan boleh dicari daripada dua titik atau pintasan."
      }
    ],
