  "intro": {
    "hook": {
      "en": "Website colours such as #6D28D9 are hexadecimal numbers. Computers use binary, and hex is a short way for people to write it.",
      "bm": "Warna laman web seperti #6D28D9 ialah nombor perenambelasan. Komputer menggunakan perduaan, dan hex cara ringkas untuk manusia menulisnya."
    },
    "bigIdeas": [
      {
        "en": "Octal uses base 8; hex uses base 16.",
        "bm": "Perlapanan menggunakan asas 8; perenambelasan asas 16."
      },
      {
        "en": "One octal digit = 3 bits; one hex digit = 4 bits.",
        "bm": "Satu digit perlapanan = 3 bit; satu digit hex = 4 bit."
      },
      {
        "en": "ASCII gives each character a number.",
        "bm": "ASCII memberi setiap aksara satu nombor."
      }
    ],
