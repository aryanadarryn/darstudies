  "intro": {
    "hook": {
      "en": "Why do pencils have erasers on the end? Someone saw two tools could be one. Inventive thinking looks at old problems in new ways.",
      "bm": "Mengapa pensel ada pemadam di hujungnya? Seseorang melihat dua alat boleh jadi satu. Pemikiran inventif melihat masalah lama dengan cara baharu."
    },
    "bigIdeas": [
      {
        "en": "Separate routine problems from inventive ones.",
        "bm": "Asingkan masalah biasa daripada masalah inventif."
      },
      {
        "en": "Function analysis shows how parts act on one another.",
        "bm": "Analisis fungsi menunjukkan cara komponen saling bertindak."
      },
      {
        "en": "A physical contradiction needs opposite properties at once.",
        "bm": "Percanggahan fizikal memerlukan sifat bertentangan serentak."
      }
    ],
    "infographic": {
      "kind": "process",
