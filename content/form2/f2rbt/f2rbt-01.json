          "bm": "Masalah inventif"
        },
        "definition": {
          "en": "A problem with no known obvious solution.",
          "bm": "Masalah tanpa penyelesaian jelas yang diketahui."
        }
      },
      {
        "term": {
          "en": "Function analysis",
          "bm": "Analisis fungsi"
        },
        "definition": {
          "en": "Studying what each part does to another.",
          "bm": "Mengkaji tindakan setiap komponen pada komponen lain."
        }
      },
