    "hook": {
      "en": "Tajwid means reciting each letter correctly, giving it its full right. It is how the Quran has been preserved in sound for centuries.",
      "bm": "Tajwid bermaksud menyebut setiap huruf dengan betul, memberi haknya. Dengan itu Al-Quran terpelihara bacaannya berabad-abad."
    },
    "bigIdeas": [
      {
        "en": "Nun sakinah and tanwin have four main rules.",
        "bm": "Nun sakinah dan tanwin mempunyai empat hukum utama."
