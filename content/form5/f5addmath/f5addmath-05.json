  "intro": {
    "hook": {
      "en": "Test scores and adult heights form a bell curve. The normal distribution lets you say how unusual a result is.",
      "bm": "Skor ujian dan ketinggian dewasa membentuk lengkung loceng. Taburan normal menunjukkan betapa luar biasa sesuatu keputusan."
    },
    "bigIdeas": [
      {
        "en": "A random variable assigns numbers to outcomes.",
        "bm": "Pemboleh ubah rawak memberi nombor kepada kesudahan."
      },
      {
        "en": "Binomial: fixed trials with two outcomes.",
        "bm": "Binomial: cubaan tetap dengan dua kesudahan."
      },
      {
        "en": "Normal: use Z = (X − μ)/σ.",
        "bm": "Normal: guna Z = (X − μ)/σ."
      }
    ],
