  "intro": {
    "hook": {
      "en": "Differentiation finds the rate of change. It tells you the steepest point on a road, the speed from a position, or the cheapest can to make.",
      "bm": "Pembezaan mencari kadar perubahan. Ia menunjukkan titik paling curam, laju daripada kedudukan, atau tin paling murah."
    },
    "bigIdeas": [
      {
        "en": "The derivative is the gradient of a curve.",
        "bm": "Terbitan ialah kecerunan lengkung."
      },
      {
        "en": "Use power, product, quotient and chain rules.",
        "bm": "Guna petua kuasa, hasil darab, hasil bahagi dan rantai."
      },
      {
        "en": "Set dy/dx = 0 to find turning points.",
        "bm": "Tetapkan dy/dx = 0 untuk mencari titik pusingan."
      }
    ],
