    "workedExample": {
      "question": {
        "en": "Find the stationary point of y = x² − 6x + 5.",
        "bm": "Cari titik pegun y = x² − 6x + 5."
      },
      "steps": [
        {
          "en": "dy/dx = 2x − 6 = 0, so x = 3.",
          "bm": "dy/dx = 2x − 6 = 0, maka x = 3."
        },
        {
          "en": "y = 9 − 18 + 5",
          "bm": "y = 9 − 18 + 5"
        }
      ],
      "answer": {
        "en": "(3, −4), a minimum",
        "bm": "(3, −4), minimum"
      }
    }
  },
