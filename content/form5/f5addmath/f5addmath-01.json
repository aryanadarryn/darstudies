  "intro": {
    "hook": {
      "en": "Engineers prefer radians because arc length becomes simply s = rθ, with no messy 360 in the formula.",
      "bm": "Jurutera memilih radian kerana panjang lengkok menjadi s = jθ tanpa 360 dalam rumus."
    },
    "bigIdeas": [
      {
        "en": "π radians = 180°.",
        "bm": "π radian = 180°."
      },
      {
        "en": "s = rθ",
        "bm": "s = jθ"
      },
      {
        "en": "A = ½r²θ",
        "bm": "L = ½j²θ"
      }
    ],
