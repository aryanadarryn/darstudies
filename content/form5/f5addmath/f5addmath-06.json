    },
    "bigIdeas": [
      {
        "en": "Sec, cosec and cot are reciprocals.",
        "bm": "Sek, kosek dan kot ialah salingan."
      },
      {
        "en": "Three basic identities link them.",
        "bm": "Tiga identiti asas menghubungkannya."
      },
      {
        "en": "Double-angle formulas simplify equations.",
        "bm": "Rumus sudut berganda mempermudah persamaan."
      }
