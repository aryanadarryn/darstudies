    "workedExample": {
      "question": {
        "en": "Given sin x = 0.6 and x acute, find cos x and sin 2x.",
        "bm": "Diberi sin x = 0.6 dan x tirus, cari kos x dan sin 2x."
      },
      "steps": [
        {
          "en": "cos x = √(1 − 0.36) = 0.8.",
          "bm": "kos x = √(1 − 0.36) = 0.8."
        },
        {
          "en": "sin 2x = 2(0.6)(0.8)",
          "bm": "sin 2x = 2(0.6)(0.8)"
        }
      ],
      "answer": {
        "en": "0.8; 0.96",
        "bm": "0.8; 0.96"
      }
    }
