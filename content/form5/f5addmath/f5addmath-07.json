  "intro": {
    "hook": {
      "en": "A bakery with limited flour and hours can find the exact mix of cakes that earns the most. That is linear programming.",
      "bm": "Kedai roti dengan tepung dan masa terhad boleh mencari campuran kek paling menguntungkan. Itulah pengaturcaraan linear."
    },
    "bigIdeas": [
      {
        "en": "Constraints are linear inequalities.",
        "bm": "Kekangan ialah ketaksamaan linear."
      },
      {
        "en": "The feasible region satisfies all constraints.",
        "bm": "Rantau tersaur memenuhi semua kekangan."
      },
      {
        "en": "The optimum lies at a vertex.",
        "bm": "Nilai optimum berada di bucu."
      }
    ],
