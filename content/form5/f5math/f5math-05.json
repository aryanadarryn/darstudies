    "keyTerms": [
      {
        "term": {
          "en": "Scale factor",
          "bm": "Faktor skala"
        },
        "definition": {
          "en": "Image length ÷ object length.",
          "bm": "Panjang imej ÷ panjang objek."
        }
      },
      {
        "term": {
          "en": "Similar",
          "bm": "Serupa"
        },
        "definition": {
          "en": "Same shape, not always the same size.",
          "bm": "Bentuk sama, saiz tidak semestinya sama."
        }
      },
      {
        "term": {
          "en": "Tessellation",
          "bm": "Teselasi"
        },
        "definition": {
          "en": "Shapes that cover a plane without gaps.",
          "bm": "Bentuk yang menutup satah tanpa ruang."
        }
      }
    ],
    "formulaIds": [
      "f5-enl-area"
    ],
    "workedExample": {
      "question": {
        "en": "An object of area 6 cm² is enlarged with k = 3. Find the image area.",
        "bm": "Objek seluas 6 cm² dibesarkan dengan k = 3. Cari luas imej."
      },
      "steps": [
        {
          "en": "Area of image = k² × area of object.",
          "bm": "Luas imej = k² × luas objek."
        },
        {
          "en": "9 × 6",
          "bm": "9 × 6"
        }
      ],
      "answer": {
        "en": "54 cm²",
        "bm": "54 cm²"
      }
    }
  },
