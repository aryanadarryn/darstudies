  "intro": {
    "hook": {
      "en": "Zoom in on a photo and the shape stays the same while the size changes. That is enlargement, and honeycombs are natural tessellations.",
      "bm": "Zum foto dan bentuknya kekal sementara saiz berubah. Itulah pembesaran, dan sarang lebah ialah teselasi semula jadi."
    },
    "bigIdeas": [
      {
        "en": "Congruent shapes are identical in shape and size.",
        "bm": "Bentuk kongruen sama bentuk dan saiz."
      },
      {
        "en": "Enlargement uses a centre and scale factor k.",
        "bm": "Pembesaran menggunakan pusat dan faktor skala k."
      },
      {
        "en": "Area scales by k².",
        "bm": "Luas berubah mengikut k²."
      }
    ],
    "infographic": {
      "kind": "concept-map",
      "data": {
