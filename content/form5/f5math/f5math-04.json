    "hook": {
      "en": "Income tax builds roads, schools and hospitals. Knowing how it is calculated helps you plan your money and claim your reliefs.",
      "bm": "Cukai pendapatan membina jalan, sekolah dan hospital. Mengetahui pengiraannya membantu merancang wang dan menuntut pelepasan."
    },
    "bigIdeas": [
      {
        "en": "Tax is charged by federal and local authorities.",
        "bm": "Cukai dikenakan oleh kerajaan persekutuan dan pihak berkuasa tempatan."
      },
      {
        "en": "Chargeable income = income − exemptions − reliefs.",
        "bm": "Pendapatan bercukai = pendapatan − pengecualian − pelepasan."
      },
      {
        "en": "Rebates reduce tax directly.",
        "bm": "Rebat mengurangkan cukai secara terus."
