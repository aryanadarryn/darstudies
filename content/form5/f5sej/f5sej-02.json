    },
    "bigIdeas": [
      {
        "en": "The Constitution is the supreme law of the country.",
        "bm": "Perlembagaan ialah undang-undang tertinggi negara."
      },
      {
        "en": "The Reid Commission drafted it in 1956 and 1957.",
        "bm": "Suruhanjaya Reid menggubalnya pada 1956 dan 1957."
      },
      {
        "en": "It was amended to form Malaysia and when Singapore left.",
        "bm": "Ia dipinda untuk membentuk Malaysia dan apabila Singapura keluar."
