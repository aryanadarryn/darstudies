    "f5addmath-03-01": {
      "keyPoints": [
        {
          "en": "Integration reverses differentiation.",
          "bm": "Pengamiran menyongsangkan pembezaan."
        },
        {
          "en": "Check by differentiating your answer.",
          "bm": "Semak dengan membezakan jawapan."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Antiderivative",
            "bm": "Antiterbitan"
          },
          "meaning": {
            "en": "Function whose derivative is given.",
            "bm": "Fungsi yang terbitannya diberi."
          }
        }
      ],
      "example": {
        "question": {
          "en": "Antiderivative of 2x?",
          "bm": "Antiterbitan 2x?"
        },
        "answer": {
          "en": "x² + c",
          "bm": "x² + c"
        }
      },
      "tip": {
        "en": "Always differentiate to check.",
        "bm": "Sentiasa bezakan untuk menyemak."
      }
    },
    "f5addmath-03-02": {
      "keyPoints": [
        {
          "en": "Do not forget + c.",
          "bm": "Jangan lupa + c."
        },
        {
          "en": "Use a point to find c.",
          "bm": "Guna titik untuk mencari c."
        }
      ],
      "keywords": [
        {
          "term": {
            "en": "Constant of integration",
            "bm": "Pemalar pengamiran"
          },
          "meaning": {
            "en": "The value c.",
            "bm": "Nilai c."
          }
        }
      ],
      "example": {
        "question": {
          "en": "∫x² dx?",
          "bm": "∫x² dx?"
        },
        "answer": {
          "en": "x³/3 + c",
          "bm": "x³/3 + c"
        }
      },
      "tip": {
        "en": "n = −1 is not in this rule.",
        "bm": "n = −1 tiada dalam petua ini."
      }
    },
    "f5addmath-03-03": {
      "keyPoints": [
        {
          "en": "Evaluate upper minus lower.",
          "bm": "Nilai had atas tolak had bawah."
