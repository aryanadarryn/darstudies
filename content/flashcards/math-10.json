    { "id": "math-10-f09", "subtopicId": "math-10-01", "front": { "en": "Pay yourself first", "bm": "Bayar diri sendiri dahulu" }, "back": { "en": "Save at least 10% of income before spending", "bm": "Simpan sekurang-kurangnya 10% pendapatan sebelum berbelanja" } },
