    { "id": "math-10-f02", "subtopicId": "math-10-01", "front": { "en": "SMART goal", "bm": "Matlamat SMART" }, "back": { "en": "Specific, Measurable, Attainable, Realistic, Time-bound", "bm": "Spesifik, boleh diukur, boleh dicapai, realistik, tempoh masa" } },
    { "id": "math-10-f03", "subtopicId": "math-10-01", "front": { "en": "Short-term vs long-term goal", "bm": "Matlamat jangka pendek vs panjang" }, "back": { "en": "Short: under 1 year. Long: more than 5 years", "bm": "Pendek: kurang 1 tahun. Panjang: lebih 5 tahun" } },
    { "id": "math-10-f04", "subtopicId": "math-10-01", "front": { "en": "Active income", "bm": "Pendapatan aktif" }, "back": { "en": "Earned by working: salary, wages, commission", "bm": "Diperoleh dengan bekerja: gaji, upah, komisen" } },
    { "id": "math-10-f05", "subtopicId": "math-10-01", "front": { "en": "Passive income", "bm": "Pendapatan pasif" }, "back": { "en": "Rent, dividends, interest, royalties", "bm": "Sewa, dividen, faedah, royalti" } },
