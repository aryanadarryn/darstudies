    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "120 of 400 students come by bus. What is the angle of the \"bus\" sector?",
        "bm": "120 daripada 400 murid datang dengan bas. Berapakah sudut sektor \"bas\"?"
      },
      "steps": [
        {
          "en": "Angle = (120 ÷ 400) × 360°.",
          "bm": "Sudut = (120 ÷ 400) × 360°."
