  "intro": {
    "hook": {
      "en": "If a school's students travel by bus, car, bicycle and on foot, a pie chart shows at a glance which slice is biggest.",
      "bm": "Jika murid sekolah datang dengan bas, kereta, basikal dan berjalan kaki, carta pai menunjukkan sepintas lalu bahagian mana paling besar."
    },
    "bigIdeas": [
      {
        "en": "A pie chart shows how a whole is divided into parts (proportions or percentages).",
        "bm": "Carta pai menunjukkan cara keseluruhan dibahagikan kepada bahagian (kadar atau peratus)."
      },
      {
        "en": "Angle of each sector = (value ÷ total) × 360°.",
        "bm": "Sudut setiap sektor = (nilai ÷ jumlah) × 360°."
      },
      {
        "en": "Interpreting means comparing sector sizes and converting angles back to values or percentages.",
        "bm": "Mentafsir bermaksud membandingkan saiz sektor dan menukar sudut kepada nilai atau peratus."
      }
    ],
    "infographic": {
      "kind": "process",
      "data": {
        "steps": [
          {
            "title": {
              "en": "Find the total",
              "bm": "Cari jumlah"
            },
            "detail": {
              "en": "Add all values.",
              "bm": "Jumlahkan semua nilai."
            }
          },
          {
            "title": {
              "en": "Calculate angles",
              "bm": "Kira sudut"
            },
            "detail": {
              "en": "(value ÷ total) × 360°.",
              "bm": "(nilai ÷ jumlah) × 360°."
            }
          },
          {
            "title": {
              "en": "Draw the circle",
              "bm": "Lukis bulatan"
            },
            "detail": {
              "en": "Draw a radius as the starting line.",
              "bm": "Lukis jejari sebagai garisan permulaan."
            }
          },
          {
            "title": {
              "en": "Draw sectors",
              "bm": "Lukis sektor"
            },
            "detail": {
              "en": "Use a protractor, largest first, clockwise.",
              "bm": "Gunakan protraktor, terbesar dahulu, ikut arah jam."
            }
          },
          {
            "title": {
              "en": "Label",
              "bm": "Label"
            },
            "detail": {
              "en": "Add title, key or labels with percentages, and source.",
              "bm": "Tambah tajuk, petunjuk atau label dengan peratus, dan sumber."
