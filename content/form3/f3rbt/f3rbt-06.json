    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "Materials cost RM4.50, labour RM3.00 and overheads RM1.50. The maker adds 20% profit. Find the selling price.",
        "bm": "Kos bahan RM4.50, upah RM3.00 dan overhed RM1.50. Pembuat menambah untung 20%. Cari harga jualan."
      },
      "steps": [
        {
          "en": "Total cost = 4.50 + 3.00 + 1.50 = RM9.00.",
          "bm": "Jumlah kos = 4.50 + 3.00 + 1.50 = RM9.00."
        },
        {
          "en": "Profit = 20% × 9.00 = RM1.80.",
          "bm": "Untung = 20% × 9.00 = RM1.80."
        },
        {
          "en": "Selling price = 9.00 + 1.80 = RM10.80.",
          "bm": "Harga jualan = 9.00 + 1.80 = RM10.80."
        }
      ],
      "answer": {
        "en": "RM10.80",
        "bm": "RM10.80"
      }
    }
  },
