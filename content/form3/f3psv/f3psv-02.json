  "intro": {
    "hook": {
      "en": "Why do fast-food logos use red and yellow, while hospitals prefer blue and green? Colours change how we feel — and designers use this on purpose.",
      "bm": "Mengapakah logo makanan segera menggunakan merah dan kuning, sedangkan hospital memilih biru dan hijau? Warna mempengaruhi perasaan — dan pereka menggunakannya dengan sengaja."
    },
    "bigIdeas": [
      {
        "en": "Primary colours (red, yellow, blue) mix to make secondary colours (orange, green, purple).",
        "bm": "Warna primer (merah, kuning, biru) dicampur untuk menghasilkan warna sekunder (jingga, hijau, ungu)."
      },
      {
        "en": "Complementary colours sit opposite on the colour wheel and create strong contrast.",
        "bm": "Warna pelengkap terletak bertentangan pada roda warna dan menghasilkan kontra yang kuat."
      },
      {
        "en": "Adding white makes a tint, black makes a shade, and grey makes a tone.",
        "bm": "Menambah putih menghasilkan tin, hitam menghasilkan syed, dan kelabu menghasilkan ton."
      }
