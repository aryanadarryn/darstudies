    "keyTerms": [
      {
        "term": {
          "en": "Primary colours",
          "bm": "Warna primer"
        },
        "definition": {
          "en": "Red, yellow and blue — cannot be mixed from other colours.",
          "bm": "Merah, kuning dan biru — tidak boleh dihasilkan daripada campuran warna lain."
        }
      },
      {
        "term": {
          "en": "Secondary colours",
          "bm": "Warna sekunder"
        },
        "definition": {
          "en": "Made by mixing two primaries: orange, green, purple.",
          "bm": "Hasil campuran dua warna primer: jingga, hijau, ungu."
        }
      },
      {
        "term": {
          "en": "Tertiary colours",
          "bm": "Warna tertier"
        },
        "definition": {
          "en": "A primary mixed with a neighbouring secondary, e.g. yellow-green.",
          "bm": "Warna primer dicampur dengan warna sekunder bersebelahan, cth. kuning-hijau."
        }
      },
      {
        "term": {
          "en": "Complementary colours",
          "bm": "Warna pelengkap"
        },
        "definition": {
          "en": "Opposites on the colour wheel: red–green, blue–orange, yellow–purple.",
          "bm": "Bertentangan pada roda warna: merah–hijau, biru–jingga, kuning–ungu."
        }
      },
      {
        "term": {
          "en": "Analogous colours",
          "bm": "Warna analogus"
        },
        "definition": {
          "en": "Neighbours on the wheel, e.g. yellow, yellow-orange, orange.",
          "bm": "Bersebelahan pada roda warna, cth. kuning, kuning-jingga, jingga."
        }
      },
      {
        "term": {
          "en": "Tint / shade",
          "bm": "Tin / syed"
        },
        "definition": {
          "en": "Colour + white / colour + black.",
          "bm": "Warna + putih / warna + hitam."
        }
      }
    ],
    "formulaIds": [],
