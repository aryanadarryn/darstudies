      },
      "back": {
        "en": "Significant → 3 s.f.",
        "bm": "Bererti → 3 a.b."
      }
    },
    {
      "id": "f3math-02-f05",
      "subtopicId": "f3math-02-01",
      "front": {
        "en": "Rounding rule",
        "bm": "Peraturan pembundaran"
      },
      "back": {
        "en": "Next digit ≥ 5 → round up; < 5 → keep",
        "bm": "Digit seterusnya ≥ 5 → bundar ke atas; < 5 → kekal"
      }
    },
    {
      "id": "f3math-02-f06",
      "subtopicId": "f3math-02-01",
      "front": {
        "en": "3.14159 to 3 s.f.",
