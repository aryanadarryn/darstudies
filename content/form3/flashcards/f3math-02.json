        "bm": "Sentiasa bererti"
      }
    },
    {
      "id": "f3math-02-f02",
      "subtopicId": "f3math-02-01",
      "front": {
        "en": "Zeros between digits (5006)",
        "bm": "Sifar di antara digit (5006)"
      },
      "back": {
        "en": "Significant → 4 s.f.",
        "bm": "Bererti → 4 a.b."
      }
    },
    {
      "id": "f3math-02-f03",
      "subtopicId": "f3math-02-01",
      "front": {
        "en": "Leading zeros (0.003)",
        "bm": "Sifar di hadapan (0.003)"
      },
      "back": {
        "en": "Not significant → 1 s.f.",
        "bm": "Tidak bererti → 1 a.b."
      }
    },
    {
      "id": "f3math-02-f04",
      "subtopicId": "f3math-02-01",
      "front": {
        "en": "Trailing zeros after the decimal point (2.50)",
