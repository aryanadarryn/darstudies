        "bm": "Masalah + pengguna sasaran"
      }
    },
    {
      "id": "f3rbt-01-f08",
      "subtopicId": "f3rbt-01-02",
      "front": {
        "en": "Specification",
        "bm": "Spesifikasi"
      },
      "back": {
        "en": "Measurable requirements: size, cost, material, safety",
        "bm": "Keperluan boleh diukur: saiz, kos, bahan, keselamatan"
      }
    },
    {
      "id": "f3rbt-01-f09",
      "subtopicId": "f3rbt-01-02",
      "front": {
        "en": "Good specification",
        "bm": "Spesifikasi yang baik"
      },
      "back": {
        "en": "Can be tested: \"holds 10 pencils\"",
        "bm": "Boleh diuji: \"muat 10 batang pensel\""
      }
    },
    {
      "id": "f3rbt-01-f10",
      "subtopicId": "f3rbt-01-02",
      "front": {
        "en": "Folio",
        "bm": "Folio"
      },
      "back": {
        "en": "Record of research, sketches, tests",
        "bm": "Rekod kajian, lakaran, ujian"
      }
    },
    {
      "id": "f3rbt-01-f11",
      "subtopicId": "f3rbt-01-03",
      "front": {
        "en": "Evaluation",
        "bm": "Penilaian"
      },
      "back": {
        "en": "Check the product against each specification",
        "bm": "Semak produk berdasarkan setiap spesifikasi"
      }
    },
    {
      "id": "f3rbt-01-f12",
      "subtopicId": "f3rbt-01-03",
      "front": {
        "en": "Feedback",
        "bm": "Maklum balas"
      },
      "back": {
        "en": "Users' comments and suggestions",
        "bm": "Komen dan cadangan pengguna"
      }
    },
    {
      "id": "f3rbt-01-f13",
      "subtopicId": "f3rbt-01-03",
      "front": {
        "en": "Iteration",
        "bm": "Iterasi"
      },
      "back": {
        "en": "Repeat the cycle to improve",
        "bm": "Ulang kitaran untuk menambah baik"
      }
    },
    {
      "id": "f3rbt-01-f14",
      "subtopicId": "f3rbt-01-03",
      "front": {
        "en": "Reliable testing",
        "bm": "Pengujian boleh dipercayai"
      },
      "back": {
        "en": "Real users, real conditions, recorded results",
        "bm": "Pengguna sebenar, keadaan sebenar, keputusan direkod"
      }
    },
    {
      "id": "f3rbt-01-f15",
      "subtopicId": "f3rbt-01-03",
      "front": {
        "en": "Why prototype?",
        "bm": "Mengapa prototaip?"
      },
      "back": {
        "en": "Find problems early and cheaply",
        "bm": "Kesan masalah awal dengan kos rendah"
      }
    }
  ]
