      "front": {
        "en": "Air pathway",
        "bm": "Laluan udara"
      },
      "back": {
        "en": "Nose → pharynx → larynx → trachea → bronchi → bronchioles → alveoli",
        "bm": "Hidung → farinks → larinks → trakea → bronkus → bronkiol → alveolus"
      }
    },
    {
      "id": "f3sci-02-f02",
      "subtopicId": "f3sci-02-01",
      "front": {
        "en": "Alveolus adaptations",
        "bm": "Penyesuaian alveolus"
      },
      "back": {
        "en": "Thin wall, moist, many capillaries, large surface area",
        "bm": "Dinding nipis, lembap, banyak kapilari, luas permukaan besar"
      }
    },
    {
      "id": "f3sci-02-f03",
      "subtopicId": "f3sci-02-02",
      "front": {
        "en": "Inhalation",
        "bm": "Tarik nafas"
      },
      "back": {
        "en": "Intercostal muscles contract, ribs up/out, diaphragm flattens, pressure falls",
        "bm": "Otot interkosta mengecut, rusuk naik/keluar, diafragma mendatar, tekanan turun"
      }
    },
    {
      "id": "f3sci-02-f04",
      "subtopicId": "f3sci-02-02",
      "front": {
        "en": "Exhalation",
        "bm": "Hembus nafas"
      },
      "back": {
        "en": "Muscles relax, ribs down/in, diaphragm curves up, pressure rises",
        "bm": "Otot mengendur, rusuk turun/masuk, diafragma melengkung, tekanan naik"
      }
    },
    {
