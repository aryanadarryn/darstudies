      "front": {
        "en": "Why transport systems?",
        "bm": "Mengapa sistem pengangkutan?"
      },
      "back": {
        "en": "Large organisms: diffusion alone is too slow",
        "bm": "Organisma besar: resapan sahaja terlalu perlahan"
      }
    },
    {
      "id": "f3sci-03-f02",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Heart chambers",
        "bm": "Ruang jantung"
      },
      "back": {
        "en": "2 atria (receive), 2 ventricles (pump)",
        "bm": "2 atrium (menerima), 2 ventrikel (mengepam)"
      }
    },
    {
      "id": "f3sci-03-f03",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Right side of heart",
        "bm": "Sisi kanan jantung"
      },
      "back": {
        "en": "Deoxygenated blood → lungs",
        "bm": "Darah terdeoksigen → peparu"
      }
    },
    {
      "id": "f3sci-03-f04",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Left side of heart",
        "bm": "Sisi kiri jantung"
      },
      "back": {
        "en": "Oxygenated blood → body",
        "bm": "Darah beroksigen → badan"
      }
    },
    {
      "id": "f3sci-03-f05",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Aorta",
        "bm": "Aorta"
      },
      "back": {
        "en": "Largest artery, from left ventricle",
        "bm": "Arteri terbesar, dari ventrikel kiri"
      }
    },
    {
      "id": "f3sci-03-f06",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Pulmonary artery / vein",
        "bm": "Arteri / vena pulmonari"
      },
      "back": {
        "en": "To lungs (deoxygenated) / from lungs (oxygenated)",
        "bm": "Ke peparu (terdeoksigen) / dari peparu (beroksigen)"
      }
    },
    {
      "id": "f3sci-03-f07",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Double circulation",
        "bm": "Peredaran berganda"
      },
      "back": {
        "en": "Pulmonary + systemic; through the heart twice",
        "bm": "Pulmonari + sistemik; melalui jantung dua kali"
      }
    },
    {
      "id": "f3sci-03-f08",
      "subtopicId": "f3sci-03-02",
      "front": {
        "en": "Artery / vein / capillary",
        "bm": "Arteri / vena / kapilari"
      },
      "back": {
        "en": "Thick, high pressure / valves, low pressure / one cell thick",
        "bm": "Tebal, tekanan tinggi / berinjap, tekanan rendah / setebal satu sel"
      }
    },
    {
      "id": "f3sci-03-f09",
      "subtopicId": "f3sci-03-03",
      "front": {
        "en": "Plasma",
        "bm": "Plasma"
      },
      "back": {
        "en": "Liquid carrying nutrients, hormones, wastes",
        "bm": "Cecair membawa nutrien, hormon, bahan buangan"
      }
    },
    {
      "id": "f3sci-03-f10",
      "subtopicId": "f3sci-03-03",
      "front": {
        "en": "Red blood cells",
        "bm": "Sel darah merah"
      },
      "back": {
        "en": "Haemoglobin, no nucleus, biconcave — carry O₂",
        "bm": "Hemoglobin, tiada nukleus, dwicekung — membawa O₂"
      }
    },
    {
      "id": "f3sci-03-f11",
      "subtopicId": "f3sci-03-03",
      "front": {
        "en": "White blood cells / platelets",
        "bm": "Sel darah putih / platlet"
      },
      "back": {
        "en": "Fight infection / blood clotting",
        "bm": "Melawan jangkitan / pembekuan darah"
      }
    },
    {
      "id": "f3sci-03-f12",
      "subtopicId": "f3sci-03-03",
      "front": {
        "en": "Universal donor / recipient (ABO)",
        "bm": "Penderma / penerima universal (ABO)"
      },
      "back": {
        "en": "O / AB",
        "bm": "O / AB"
      }
    },
    {
