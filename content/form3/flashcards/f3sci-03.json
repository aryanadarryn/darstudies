      },
      "back": {
        "en": "Light, temperature, wind; decreases with humidity",
        "bm": "Cahaya, suhu, angin; berkurang dengan kelembapan"
      }
    },
    {
      "id": "f3sci-03-f15",
      "subtopicId": "f3sci-03-04",
      "front": {
        "en": "Bark ringing",
        "bm": "Pengelangan batang"
      },
      "back": {
        "en": "Swelling above the ring → phloem carries food",
        "bm": "Bengkak di atas gelang → floem mengangkut makanan"
      }
