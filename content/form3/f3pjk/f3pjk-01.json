          "bm": "Daya maksimum yang dapat dihasilkan otot sekali."
        }
      },
      {
        "term": {
          "en": "Flexibility",
          "bm": "Kelenturan"
        },
        "definition": {
          "en": "Range of movement around a joint.",
          "bm": "Julat pergerakan pada sendi."
        }
      },
      {
        "term": {
          "en": "Agility",
          "bm": "Ketangkasan"
        },
        "definition": {
          "en": "Changing direction quickly with control.",
          "bm": "Menukar arah dengan cepat dan terkawal."
        }
      },
      {
        "term": {
          "en": "FITT",
          "bm": "FITT"
        },
        "definition": {
          "en": "Frequency, Intensity, Time, Type.",
          "bm": "Kekerapan, Intensiti, Masa, Jenis."
        }
      },
      {
        "term": {
          "en": "BMI",
          "bm": "Indeks Jisim Tubuh (IJT)"
        },
        "definition": {
          "en": "Body mass (kg) ÷ height² (m²).",
          "bm": "Jisim badan (kg) ÷ tinggi² (m²)."
        }
      }
    ],
    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "Aina has a mass of 50 kg and a height of 1.6 m. Calculate her BMI.",
        "bm": "Aina mempunyai jisim 50 kg dan tinggi 1.6 m. Hitung IJT beliau."
      },
      "steps": [
        {
          "en": "Height² = 1.6 × 1.6 = 2.56 m².",
          "bm": "Tinggi² = 1.6 × 1.6 = 2.56 m²."
        },
        {
          "en": "BMI = 50 ÷ 2.56 ≈ 19.5.",
          "bm": "IJT = 50 ÷ 2.56 ≈ 19.5."
        },
        {
          "en": "For teenagers, BMI is compared with age-and-sex charts; your teacher or clinic will interpret it.",
          "bm": "Bagi remaja, IJT dibandingkan dengan carta mengikut umur dan jantina; guru atau klinik akan mentafsirnya."
        }
      ],
      "answer": {
        "en": "About 19.5 kg/m².",
        "bm": "Kira-kira 19.5 kg/m²."
      }
    }
  },
