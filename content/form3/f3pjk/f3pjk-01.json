        "term": {
          "en": "Cardiovascular endurance",
          "bm": "Daya tahan kardiovaskular"
        },
        "definition": {
          "en": "Ability of the heart and lungs to supply oxygen during long activity.",
          "bm": "Keupayaan jantung dan paru-paru membekalkan oksigen semasa aktiviti yang lama."
