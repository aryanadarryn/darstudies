  "intro": {
    "hook": {
      "en": "Planning a school sports day, sorting library books or finding the fastest bus route are all problems a computer scientist would break into small, logical steps.",
      "bm": "Merancang hari sukan sekolah, menyusun buku perpustakaan atau mencari laluan bas terpantas ialah masalah yang akan dipecahkan oleh saintis komputer kepada langkah kecil yang logik."
    },
    "bigIdeas": [
      {
        "en": "Computational thinking has four parts: decomposition, pattern recognition, abstraction and algorithms.",
        "bm": "Pemikiran komputasional mempunyai empat bahagian: leraian, pengecaman corak, peniskalaan dan algoritma."
      },
      {
        "en": "An algorithm is a clear, step-by-step set of instructions; it can be shown as a flowchart or pseudocode.",
        "bm": "Algoritma ialah set arahan langkah demi langkah yang jelas; ia boleh ditunjukkan sebagai carta alir atau pseudokod."
      },
      {
        "en": "All programs are built from three control structures: sequence, selection and repetition.",
        "bm": "Semua atur cara dibina daripada tiga struktur kawalan: urutan, pilihan dan pengulangan."
      }
    ],
