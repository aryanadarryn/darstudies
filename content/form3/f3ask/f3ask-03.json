  "intro": {
    "hook": {
      "en": "Every photo, song and message on your phone is stored as 0s and 1s. Organising those bits into lists is how programs find things fast.",
      "bm": "Setiap gambar, lagu dan mesej dalam telefon anda disimpan sebagai 0 dan 1. Menyusun bit itu ke dalam senarai membolehkan atur cara mencari maklumat dengan pantas."
    },
    "bigIdeas": [
      {
        "en": "Computers store data in binary (base 2); 8 bits = 1 byte.",
        "bm": "Komputer menyimpan data dalam perduaan (asas 2); 8 bit = 1 bait."
      },
      {
        "en": "A list stores many values in order; Python indexes start at 0.",
        "bm": "Senarai menyimpan banyak nilai mengikut turutan; indeks Python bermula dengan 0."
      },
      {
        "en": "Linear search checks every item; binary search is faster but needs a sorted list.",
        "bm": "Carian linear menyemak setiap item; carian perduaan lebih pantas tetapi memerlukan senarai yang telah diisih."
      }
    ],
