    "keyTerms": [
      {
        "term": {
          "en": "Tag",
          "bm": "Tag"
        },
        "definition": {
          "en": "A keyword in angle brackets, usually in pairs: <p> … </p>.",
          "bm": "Kata kunci dalam kurungan sudut, biasanya berpasangan: <p> … </p>."
        }
      },
      {
        "term": {
          "en": "Attribute",
          "bm": "Atribut"
        },
        "definition": {
          "en": "Extra information inside a tag: href, src, alt.",
          "bm": "Maklumat tambahan dalam tag: href, src, alt."
        }
      },
      {
        "term": {
          "en": "Element",
          "bm": "Elemen"
        },
        "definition": {
          "en": "Opening tag + content + closing tag.",
          "bm": "Tag pembuka + kandungan + tag penutup."
        }
      },
      {
        "term": {
          "en": "Selector",
          "bm": "Pemilih"
        },
        "definition": {
          "en": "Chooses what CSS styles: p, .class, #id.",
          "bm": "Memilih apa yang digayakan CSS: p, .class, #id."
        }
      },
      {
        "term": {
          "en": "External stylesheet",
          "bm": "Helaian gaya luaran"
        },
        "definition": {
