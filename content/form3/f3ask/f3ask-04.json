  "intro": {
    "hook": {
      "en": "Every website you visit — from your school portal to YouTube — is built on HTML for structure and CSS for style.",
      "bm": "Setiap laman web yang anda lawati — daripada portal sekolah hingga YouTube — dibina dengan HTML untuk struktur dan CSS untuk gaya."
    },
    "bigIdeas": [
      {
        "en": "HTML uses tags to mark up content: <h1> for headings, <p> for paragraphs, <a> for links, <img> for images.",
        "bm": "HTML menggunakan tag untuk menanda kandungan: <h1> untuk tajuk, <p> untuk perenggan, <a> untuk pautan, <img> untuk imej."
      },
      {
        "en": "A page has <html>, <head> (information such as <title>) and <body> (visible content).",
        "bm": "Halaman mempunyai <html>, <head> (maklumat seperti <title>) dan <body> (kandungan yang dipaparkan)."
      },
      {
        "en": "CSS rules have a selector and declarations: p { color: blue; }.",
        "bm": "Peraturan CSS mempunyai pemilih dan pengisytiharan: p { color: blue; }."
      }
    ],
