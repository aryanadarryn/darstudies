    "workedExample": {
      "question": {
        "en": "Simplify (2a³b)² × a⁻⁴.",
        "bm": "Ringkaskan (2a³b)² × a⁻⁴."
      },
      "steps": [
        {
          "en": "Power of a power: (2a³b)² = 2²a⁶b² = 4a⁶b².",
          "bm": "Kuasa bagi kuasa: (2a³b)² = 2²a⁶b² = 4a⁶b²."
        },
        {
          "en": "Multiply: 4a⁶b² × a⁻⁴ = 4a⁶⁺⁽⁻⁴⁾b² = 4a²b².",
          "bm": "Darab: 4a⁶b² × a⁻⁴ = 4a⁶⁺⁽⁻⁴⁾b² = 4a²b²."
        }
      ],
      "answer": {
        "en": "4a²b²",
        "bm": "4a²b²"
      }
    }
  },
