    "keyTerms": [
      {
        "term": {
          "en": "Significant figures (s.f.)",
          "bm": "Angka bererti (a.b.)"
        },
        "definition": {
          "en": "Digits that carry meaning about the precision of a number.",
          "bm": "Digit yang memberi makna tentang kejituan nombor."
        }
      },
      {
        "term": {
          "en": "Standard form",
          "bm": "Bentuk piawai"
        },
        "definition": {
          "en": "A × 10ⁿ, 1 ≤ A < 10, n an integer.",
          "bm": "A × 10ⁿ, 1 ≤ A < 10, n integer."
        }
      },
      {
        "term": {
          "en": "Rounding",
          "bm": "Pembundaran"
        },
        "definition": {
          "en": "Shortening a number to a given number of significant figures.",
          "bm": "Memendekkan nombor kepada bilangan angka bererti tertentu."
        }
      }
    ],
    "formulaIds": [
      "f3-std"
    ],
    "workedExample": {
      "question": {
        "en": "Write 0.000 405 6 in standard form correct to 3 significant figures.",
        "bm": "Tulis 0.000 405 6 dalam bentuk piawai betul kepada 3 angka bererti."
      },
      "steps": [
        {
          "en": "Round to 3 s.f.: 0.000 405 6 → 0.000 406 (the 4th s.f. is 6, so round up).",
          "bm": "Bundarkan kepada 3 a.b.: 0.000 405 6 → 0.000 406 (a.b. ke-4 ialah 6, jadi bundar ke atas)."
        },
        {
          "en": "Move the decimal point 4 places right to get 4.06.",
          "bm": "Gerakkan titik perpuluhan 4 tempat ke kanan untuk mendapat 4.06."
        },
        {
          "en": "The number is less than 1, so the index is −4.",
          "bm": "Nombor kurang daripada 1, jadi indeksnya −4."
        }
      ],
      "answer": {
        "en": "4.06 × 10⁻⁴",
        "bm": "4.06 × 10⁻⁴"
      }
    }
  },
