  "intro": {
    "hook": {
      "en": "The Sun is about 150 000 000 km away and a red blood cell is about 0.000 008 m wide. Writing so many zeros is slow and risky — standard form fixes that.",
      "bm": "Matahari berjarak kira-kira 150 000 000 km dan sel darah merah berlebar kira-kira 0.000 008 m. Menulis banyak sifar lambat dan berisiko — bentuk piawai menyelesaikannya."
    },
    "bigIdeas": [
      {
        "en": "Significant figures show how precise a number is.",
        "bm": "Angka bererti menunjukkan kejituan sesuatu nombor."
      },
      {
        "en": "Standard form is A × 10ⁿ where 1 ≤ A < 10 and n is an integer.",
        "bm": "Bentuk piawai ialah A × 10ⁿ dengan 1 ≤ A < 10 dan n ialah integer."
      },
      {
        "en": "Large numbers have a positive n; small numbers (less than 1) have a negative n.",
        "bm": "Nombor besar mempunyai n positif; nombor kecil (kurang daripada 1) mempunyai n negatif."
      }
    ],
