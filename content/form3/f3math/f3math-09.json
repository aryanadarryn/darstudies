    "workedExample": {
      "question": {
        "en": "Find the equation of the line through (1, 2) and (4, 11).",
        "bm": "Cari persamaan garis lurus yang melalui (1, 2) dan (4, 11)."
      },
      "steps": [
        {
          "en": "m = (11 − 2)/(4 − 1) = 3.",
          "bm": "m = (11 − 2)/(4 − 1) = 3."
        },
        {
          "en": "Substitute (1, 2) into y = mx + c: 2 = 3(1) + c → c = -1.",
          "bm": "Gantikan (1, 2) ke dalam y = mx + c: 2 = 3(1) + c → c = -1."
        }
      ],
      "answer": {
        "en": "y = 3x − 1",
        "bm": "y = 3x − 1"
      }
    }
  },
