  "intro": {
    "hook": {
      "en": "A taxi charges RM4 to start plus RM1.50 per km. Plot fare against distance and you get a straight line — its steepness is the rate per km, and where it starts is the RM4.",
      "bm": "Teksi mengenakan RM4 tambang permulaan dan RM1.50 sekilometer. Plot tambang melawan jarak dan anda mendapat garis lurus — kecuraman ialah kadar per km, dan titik mula ialah RM4."
    },
    "bigIdeas": [
      {
        "en": "The gradient m measures steepness: m = (y₂ − y₁)/(x₂ − x₁).",
        "bm": "Kecerunan m mengukur kecuraman: m = (y₂ − y₁)/(x₂ − x₁)."
      },
      {
        "en": "Every non-vertical straight line can be written as y = mx + c, where c is the y-intercept.",
        "bm": "Setiap garis lurus yang tidak mencancang boleh ditulis sebagai y = mx + c, dengan c ialah pintasan-y."
      },
      {
        "en": "Parallel lines have equal gradients; two lines meet where their equations are both true.",
        "bm": "Garis selari mempunyai kecerunan sama; dua garis bersilang di titik yang memenuhi kedua-dua persamaan."
      }
    ],
