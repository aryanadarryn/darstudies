    "keyTerms": [
      {
        "term": {
          "en": "Tempo",
          "bm": "Tempo"
        },
        "definition": {
          "en": "The speed of the beat.",
          "bm": "Kelajuan detik."
        }
      },
      {
        "term": {
          "en": "Dynamics",
          "bm": "Dinamik"
        },
        "definition": {
          "en": "How loud or soft the music is.",
          "bm": "Kekuatan atau kelembutan bunyi muzik."
        }
      },
      {
        "term": {
          "en": "Pitch",
          "bm": "Pic"
        },
        "definition": {
          "en": "How high or low a sound is.",
          "bm": "Tinggi atau rendah sesuatu bunyi."
        }
      },
      {
        "term": {
          "en": "Timbre",
          "bm": "Warna ton"
        },
        "definition": {
          "en": "The unique quality of a voice or instrument.",
          "bm": "Kualiti unik suara atau alat muzik."
        }
      },
      {
        "term": {
          "en": "Texture",
          "bm": "Tekstur"
        },
        "definition": {
          "en": "Monophonic (one line), homophonic (melody + chords), polyphonic (several melodies).",
          "bm": "Monofoni (satu garisan), homofoni (melodi + kord), polifoni (beberapa melodi)."
        }
      },
      {
        "term": {
          "en": "Form",
          "bm": "Bentuk"
        },
        "definition": {
          "en": "The order of sections in a piece: AB, ABA, ABACA.",
          "bm": "Susunan bahagian dalam lagu: AB, ABA, ABACA."
        }
      }
    ],
    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "A song has sections: verse A, chorus B, verse A again. What is its form?",
        "bm": "Sebuah lagu mempunyai bahagian: A, B, kemudian A semula. Apakah bentuknya?"
      },
      "steps": [
        {
          "en": "Label each section with a letter.",
          "bm": "Labelkan setiap bahagian dengan huruf."
        },
        {
          "en": "A B A — the first section returns at the end.",
          "bm": "A B A — bahagian pertama kembali di akhir."
        }
      ],
      "answer": {
        "en": "Ternary form (ABA).",
        "bm": "Bentuk ternari (ABA)."
      }
    }
  },
