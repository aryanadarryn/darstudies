  "intro": {
    "hook": {
      "en": "The same melody can sound peaceful or thrilling just by changing how fast and how loud it is played.",
      "bm": "Melodi yang sama boleh kedengaran tenang atau mendebarkan hanya dengan mengubah kelajuan dan kekuatan bunyinya."
    },
    "bigIdeas": [
      {
        "en": "Tempo is the speed of music (largo → presto); dynamics is loudness (pp → ff).",
        "bm": "Tempo ialah kelajuan muzik (largo → presto); dinamik ialah kekuatan bunyi (pp → ff)."
      },
      {
        "en": "Timbre is the \"colour\" of a sound; texture is how many layers of sound are heard together.",
        "bm": "Warna ton ialah \"warna\" bunyi; tekstur ialah bilangan lapisan bunyi yang didengar serentak."
      },
      {
        "en": "Form is the structure of a piece: binary (AB), ternary (ABA) and rondo (ABACA).",
        "bm": "Bentuk ialah struktur lagu: binari (AB), ternari (ABA) dan rondo (ABACA)."
      }
    ],
