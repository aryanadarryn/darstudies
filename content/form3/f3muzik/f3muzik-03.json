  "intro": {
    "hook": {
      "en": "A serunai, a sape, a kompang and a gong all make music — but each produces sound in a completely different way.",
      "bm": "Serunai, sape, kompang dan gong semuanya menghasilkan muzik — tetapi setiap satu menghasilkan bunyi dengan cara yang sangat berbeza."
    },
    "bigIdeas": [
      {
        "en": "Instruments are classified by what vibrates to make the sound.",
        "bm": "Alat muzik dikelaskan berdasarkan bahagian yang bergetar untuk menghasilkan bunyi."
      },
      {
        "en": "Aerophone (air), chordophone (string), membranophone (stretched skin), idiophone (the body itself), electrophone (electronic).",
        "bm": "Aerofon (udara), kordofon (tali), membranofon (kulit yang diregang), idiofon (badan alat itu sendiri), elektrofon (elektronik)."
      },
      {
        "en": "Malaysian traditional instruments fit these groups too: serunai, sape, kompang, gong.",
        "bm": "Alat muzik tradisional Malaysia juga sesuai dalam kumpulan ini: serunai, sape, kompang, gong."
      }
    ],
