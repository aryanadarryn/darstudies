    "keyTerms": [
      {
        "term": {
          "en": "Aerophone",
          "bm": "Aerofon"
        },
        "definition": {
          "en": "Sound from vibrating air.",
          "bm": "Bunyi daripada getaran udara."
        }
      },
      {
        "term": {
          "en": "Chordophone",
          "bm": "Kordofon"
        },
        "definition": {
          "en": "Sound from vibrating strings (plucked, bowed or struck).",
          "bm": "Bunyi daripada getaran tali (dipetik, digesek atau dipalu)."
        }
      },
      {
        "term": {
          "en": "Membranophone",
          "bm": "Membranofon"
        },
        "definition": {
          "en": "Sound from a vibrating stretched membrane (drum skin).",
          "bm": "Bunyi daripada getaran membran yang diregang (kulit gendang)."
        }
      },
      {
        "term": {
          "en": "Idiophone",
          "bm": "Idiofon"
        },
        "definition": {
          "en": "Sound from the instrument's own material vibrating.",
          "bm": "Bunyi daripada getaran bahan alat itu sendiri."
        }
      },
      {
        "term": {
          "en": "Electrophone",
          "bm": "Elektrofon"
        },
        "definition": {
          "en": "Sound produced electronically.",
          "bm": "Bunyi yang dihasilkan secara elektronik."
        }
      },
      {
        "term": {
          "en": "Ensemble",
          "bm": "Ensembel"
        },
        "definition": {
          "en": "A group of musicians performing together.",
          "bm": "Kumpulan pemuzik yang bermain bersama."
        }
      }
    ],
    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "Classify the angklung.",
        "bm": "Kelaskan angklung."
      },
      "steps": [
        {
          "en": "The angklung is made of bamboo tubes in a frame.",
          "bm": "Angklung diperbuat daripada tiub buluh dalam rangka."
        },
        {
          "en": "When shaken, the bamboo itself vibrates — there is no string, skin or air column being blown.",
          "bm": "Apabila digoncang, buluh itu sendiri bergetar — tiada tali, kulit atau tiupan udara."
        }
      ],
      "answer": {
        "en": "Idiophone.",
        "bm": "Idiofon."
      }
    }
  },
