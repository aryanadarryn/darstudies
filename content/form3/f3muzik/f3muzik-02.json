    "keyTerms": [
      {
        "term": {
          "en": "Stave (staff)",
          "bm": "Baluk"
        },
        "definition": {
          "en": "Five lines and four spaces on which notes are written.",
          "bm": "Lima garisan dan empat ruang tempat not ditulis."
        }
      },
      {
        "term": {
          "en": "Treble clef",
          "bm": "Klef trebel"
        },
        "definition": {
          "en": "Clef for higher notes; also called the G clef.",
          "bm": "Klef untuk not tinggi; juga dipanggil klef G."
        }
      },
      {
        "term": {
          "en": "Bass clef",
          "bm": "Klef bes"
        },
        "definition": {
          "en": "Clef for lower notes; also called the F clef.",
          "bm": "Klef untuk not rendah; juga dipanggil klef F."
        }
      },
      {
        "term": {
          "en": "Time signature",
          "bm": "Meter"
        },
        "definition": {
          "en": "Top number = beats per bar; bottom 4 = crotchet beat.",
          "bm": "Nombor atas = detik setiap bar; nombor bawah 4 = detik krocet."
        }
      },
      {
        "term": {
          "en": "Bar line",
          "bm": "Garis bar"
        },
        "definition": {
          "en": "Vertical line that divides music into bars (measures).",
          "bm": "Garisan menegak yang membahagikan muzik kepada bar."
        }
      },
      {
        "term": {
          "en": "Rest",
          "bm": "Tanda rehat"
        },
        "definition": {
          "en": "A symbol for silence of a set length.",
          "bm": "Simbol senyap bagi tempoh tertentu."
        }
      }
    ],
    "formulaIds": [],
    "workedExample": {
      "question": {
        "en": "In 4/4 time, a bar has a minim, a crotchet and two quavers. Is the bar complete?",
        "bm": "Dalam meter 4/4, satu bar mengandungi satu minim, satu krocet dan dua kuaver. Adakah bar itu lengkap?"
      },
      "steps": [
        {
          "en": "Minim = 2, crotchet = 1, two quavers = ½ + ½ = 1.",
          "bm": "Minim = 2, krocet = 1, dua kuaver = ½ + ½ = 1."
        },
        {
          "en": "Total = 2 + 1 + 1 = 4 beats.",
          "bm": "Jumlah = 2 + 1 + 1 = 4 detik."
        }
      ],
      "answer": {
        "en": "Yes — 4 beats fill a 4/4 bar.",
        "bm": "Ya — 4 detik memenuhi bar 4/4."
      }
    }
  },
