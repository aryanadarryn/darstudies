  "intro": {
    "hook": {
      "en": "Musicians in Kuala Lumpur and Kuching can play the same piece perfectly from a page — because staff notation is a shared language.",
      "bm": "Pemuzik di Kuala Lumpur dan Kuching boleh memainkan lagu yang sama dengan tepat daripada satu halaman — kerana notasi baluk ialah bahasa yang dikongsi."
    },
    "bigIdeas": [
      {
        "en": "In 4/4 time a semibreve = 4 beats, minim = 2, crotchet = 1, quaver = ½, semiquaver = ¼.",
        "bm": "Dalam meter 4/4, semibrif = 4 detik, minim = 2, krocet = 1, kuaver = ½, semikuaver = ¼."
      },
      {
        "en": "A dot after a note adds half its value (dotted minim = 3 beats).",
        "bm": "Titik selepas not menambah separuh nilainya (minim bertitik = 3 detik)."
      },
      {
        "en": "Treble clef lines are E G B D F; spaces are F A C E.",
        "bm": "Garisan klef trebel ialah E G B D F; ruang ialah F A C E."
      }
    ],
